using namespace std;
struct pair_hash {
    template <class T1, class T2>
    std::size_t operator () (const std::pair<T1, T2>& pair) const {
        auto hash1 = std::hash<T1>{}(pair.first);   // Хэшируем первый элемент
        auto hash2 = std::hash<T2>{}(pair.second);  // Хэшируем второй элемент
        return hash1 ^ hash2;                       // Комбинируем хэши
    }
};
struct Node
{
    int id = 0;
    double lon, lat;
    int color = 0;
    Node() = default;
    Node(double lon, double lat)
    {
        this->lon = lon;
        this->lat = lat;
    }
    vector<pair<Node*, double>> neighbors;
};
struct Graph
{
